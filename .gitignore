node_modules/
dist/
# SQLite runtime data — never source-controlled
*.db
*.db-shm
*.db-wal
# Env files — ignore .env and ALL variants (incl. ".env.local" and ".env copy"); keep .env.example tracked
.env*
!.env.example
.vite/
# WMS spike scratch output (wmsSpike.ts writes here). The tracked test fixture lives at
# server/src/wmsCapabilities.xml and is intentionally NOT ignored.
/packages/server/src/spikes/wmsCapabilities.xml
# CB+Track WMS spike raw tile-byte output (npm run cb-track-spike)
/packages/server/spike-output/
# Local agent config — excluded from the repo
.claude/
# GSD planning docs (phase plans, UAT notes, milestone archives) stay local; untracked 2026-11-03.
.planning/
# Stray agent scratch files
/scratchpad/
# Local-only runtime data dir
/packages/server/data/
# macOS Finder metadata
.DS_Store
# Tool-call spike outputs (npm run tool-call-spike); may hold wire captures
/packages/server/s6-*
