PORT=4000
KINETICA_URL=https://localhost:9191
CORS_ORIGIN=http://localhost:5173
DB_PATH=./data/kinetica.db
# Random string >= 16 chars used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-long-random-string
# 32 bytes (64 hex chars) used to encrypt session passwords at rest with AES-256-GCM.
# Independent from AUTH_SECRET. Rotation forces all currently-logged-in users to re-login.
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=replace-me-with-64-hex-chars-from-openssl-rand-hex-32
# ---- OIDC SSO (v1.1) ----
# AUTH_MODE selects the auth flow. Default: password (v1.0 behavior).
# When set to 'oidc', the password login route returns 400 and the OIDC start/callback routes are active.
# Boot fails if AUTH_MODE is anything other than 'password' or 'oidc'.
AUTH_MODE=password
# OIDC issuer URL — base of /.well-known/openid-configuration. Trailing slash is stripped at boot.
# Example (Keycloak): https://auth.example.com/realms/myrealm
# Example (Okta):     https://example.okta.com
AUTH_OIDC_ISSUER_URL=
# OIDC client ID registered at the IdP for this BI deployment.
AUTH_OIDC_CLIENT_ID=
# OIDC client secret. Confidential client — keep out of version control.
AUTH_OIDC_CLIENT_SECRET=
# Exact redirect URI registered at the IdP. MUST be the exact-match callback URL — no wildcards.
# Dev:  http://localhost:4000/api/auth/oidc/callback
# Prod: https://bi.example.com/api/auth/oidc/callback
AUTH_OIDC_REDIRECT_URI=
# OIDC claim from the verified id_token to use as the BI/Kinetica username. Defaults to preferred_username.
# Common alternatives: email, sub. Verify with your IdP + Kinetica account naming convention.
AUTH_OIDC_USERNAME_CLAIM=preferred_username
# Optional regex applied to the claim value. Capture group 1 used if present, else full match.
# Example (extract local-part of email): ^([^@]+)@.*$
# Empty/unset = use claim value as-is.
AUTH_OIDC_USERNAME_REGEX=
# ---- v1.8 RBAC bootstrap admin ----
# v1.8 RBAC bootstrap admin. This username always resolves to ALL permissions and can never be
# locked out (short-circuit before any DB lookup). Case-insensitive. Default "admin" is the
# Kinetica built-in superuser (password mode). In OIDC mode, set this to the intended admin's
# OIDC username (the post-regex claim value) — otherwise no OIDC user gets bootstrap admin and
# the server logs an rbac_bootstrap_admin_warning at boot.
APP_ADMIN_USERNAME=admin
# ---- Tuning knobs (read once at boot; invalid/empty → default + warn, never fail-fast) ----
# Materialized-view TTL in minutes for filter-views + dynamic-views (v1.15). Default 5.
DEFAULT_VIEW_TTL_MINUTES=5
# Minutes before a view's TTL expiry that the client fires a keep-alive touch (v1.15). Default 1.
TTL_KEEPALIVE_LEAD_MINUTES=1
# Max distinct per-combination materialized views per table for per-visualization filter selection
# (v1.18). Over-ceiling combinations fall back to the full all-filters view. Default 10.
MAX_COMBINATION_VIEWS_PER_TABLE=10
# Set to 'true' to fully disable dynamic-view filter scope (v1.18). Default (unset/anything else) = enabled.
DISABLE_DV_FILTER_SCOPE=false
# Max colored series rendered on a multi-column-group-by bar chart (v1.19). Over-cap keeps the
# top-N series by aggregate + shows a truncation note. NOT a cap on group-by column count. Default 12.
MAX_BAR_GROUP_BY_SERIES=12
# Max rows any single app query may return (v1.26). Replaces the old hardcoded 1,000. Default 20000.
# May exceed KINETICA_MAX_RECORDS_PER_CALL — the server then splits the query into several calls.
KINETICA_MAX_ROWS_PER_QUERY=20000
# Max rows requested from Kinetica in ONE /execute/sql call (v1.26). Must not exceed the Kinetica
# server's max_get_records_size (default 20000). If set higher, the server keeps paging and logs a warning once.
KINETICA_MAX_RECORDS_PER_CALL=20000
# Hard ceiling on the in-browser CSV download (v1.26). A widget's "CSV Download Row Cap" cannot exceed it. Default 100000.
CSV_INBROWSER_MAX_ROWS=100000

# Export limits (Phase 130). Invalid values warn at runtime and fall back (TTL 24, concurrency 2,
# row/size caps OFF - a typo disables a cap, so check the server log).
# Hours a finished export (and its history row, including failed/cancelled ones) is kept after it finishes. Default 24.
EXPORT_TTL_HOURS=24
# Max rows per background export; an export over it fails before writing. Unset = unlimited.
# EXPORT_MAX_ROWS=10000000
# Max export file size on disk in MB (MiB; the .zip size when Compress is ticked). Unset = unlimited.
# EXPORT_MAX_FILE_MB=2048
# Max queued+running exports per user; extra starts are refused with 429. Default 2.
EXPORT_MAX_CONCURRENT_PER_USER=2

# ---- AI (v2.0, optional). OFF unless AI_ENABLED=true. Invalid settings disable AI (the app still starts; see the [ai] line in the server log). ----
# AI_ENABLED=false
# AI_PROVIDER=openai-compatible        # openai-compatible | claude
# AI_DATA_ACCESS=schema                # schema (default: structure only, no row values) | query
# AI_MAX_TOOL_STEPS=8                  # 1-50
# AI_TIMEOUT_MS=60000                  # 1000-600000
# AI_MAX_ANSWERS_PER_USER_PER_HOUR=30  # 0 = no cap
# AI_MAX_ANSWERS_PER_DAY=0             # whole deployment, rolling 24 h; 0 = off (use for shared/free-tier keys)
# AI_AUDIT_RETENTION_DAYS=90           # 0 = keep forever; applies even when AI is off
# AI_GENERATED_TTL_HOURS=24            # 0-8760; a generated dashboard nobody kept is deleted after this many hours (also on logout and server start); 0 = only on logout/start
# AI_HISTORY_TURNS=6                  # 1-20 recent exchanges sent in full
# AI_TOOL_MODE=native                  # native | json (fallback for models with weak tool calling)
# AI_MAX_NEW_WIDGETS=6                # 1-30 new widgets per AI answer; extra adds are skipped and reported
# Generate mode (a new dashboard built from one table) uses at least 20 tool steps and at most 8 new widgets, whatever these two are set to.
# AI_DV_MAX_RECORDS=100000            # 1-10000000 row ceiling for AI dynamic views (a view may ask for less)
# AI_DV_MAX_JOINS=2                   # 0-4 joined tables per AI dynamic view (INNER/LEFT, equality keys)
# AI_DV_MAX_PER_SESSION=5             # 1-20 AI dynamic views per login session
# AI_DV_PREFLIGHT_TIMEOUT_MS=30000    # 1000-600000 build deadline; on timeout the Kinetica job is cancelled
# Query mode only (AI_DATA_ACCESS=query): run_query / get_column_profile are the AI's OWN read tools (answers in words); charts keep their own queries and limits.
# AI_QUERY_MAX_ROWS=200               # 1-5000 rows returned to the AI per query (truncation is reported to it)
# AI_QUERY_MAX_CHARS=20000            # 1000-200000 characters of one query result sent to the AI (long cells are clipped)
# AI_QUERY_TIMEOUT_MS=30000           # 1000-600000 per-query deadline; the Kinetica job is cancelled on timeout or Cancel
# AI_QUERY_MAX_PER_ANSWER=5           # 1-20 queries per AI answer (refused queries do not count)
# Gemini (Google AI Studio), tested model:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3-flash-preview        # the model ID, not a product name (a wrong ID fails every request with HTTP 400)
# AI_API_KEY=<your AI Studio key>
# AI_TIMEOUT_MS=120000                   # Gemini 3 "thinking" models can exceed 60 s on a cold first call
# Free tier: about 20 requests per day per model and one answer uses several; set AI_MAX_ANSWERS_PER_DAY to match.
# Ollama (local, no key), tested model, run in Docker:
#   docker run -d --name kbi-ollama -v kbi-ollama:/root/.ollama -p 127.0.0.1:11434:11434 \
#     -e OLLAMA_CONTEXT_LENGTH=16384 -e OLLAMA_NUM_PARALLEL=1 -e OLLAMA_KEEP_ALIVE=30m ollama/ollama
#   docker exec kbi-ollama ollama pull qwen2.5:7b-instruct
#   OLLAMA_CONTEXT_LENGTH matters: Ollama's CPU default context (4k) silently cuts off the AI's instructions.
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5:7b-instruct
# AI_TIMEOUT_MS=600000                   # CPU-only answers take minutes
# AI_TOOL_MODE=json                   # tested: qwen2.5:7b-instruct needs the json fallback

# ---- Claude Desktop connector (v2.0 Phase 143, optional). OFF unless MCP_ENABLED=true. See packages/mcp/README.md. ----
# MCP_ENABLED=false
# MCP_APP_URL=http://localhost:5173      # the web address used in the review link Claude returns
# MCP_TOKEN_TTL_DAYS=90                  # 1-365; users create tokens on their Profile page (password sign-in only)
